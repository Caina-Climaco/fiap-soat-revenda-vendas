          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Dados inválidos"
          }
        },
        "security": [
          {
            "token-servico": []
          }
        ],
        "summary": "T2: bloquear veículo para a compra",
        "tags": [
          "Interno: saga da compra"
        ]
      }
    },
    "/internal/v1/veiculos/{veiculo_id}/bloqueio/{compra_id}": {
