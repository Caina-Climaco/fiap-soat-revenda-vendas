                }
              }
            },
            "description": "Recurso não encontrado"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Conflito de estado"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problema"
                }
              }
            },
            "description": "Dados inválidos"
          }
        },
        "security": [
          {
            "token-servico": []
          }
        ],
        "summary": "C2: desfazer o bloqueio da compra",
        "tags": [
          "Interno: saga da compra"
        ]
      }
    },
    "/internal/v1/veiculos/{veiculo_id}/venda": {
      "post": {
        "description": "Passo retentável (depois do pivô); idempotente pela compra_id.",
        "operationId": "vender_internal_v1_veiculos__veiculo_id__venda_post",
        "parameters": [
          {
            "description": "Identificador do veículo (UUID).",
            "in": "path",
            "name": "veiculo_id",
            "required": true,
            "schema": {
              "description": "Identificador do veículo (UUID).",
              "format": "uuid",
              "title": "Veiculo Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VendaRequisicao"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PassoSagaResposta"
                }
              }
